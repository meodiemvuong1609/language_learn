# Copy to .env.local for local dev:
#   cp .env.example .env.local
#
# Axios baseURL is set in src/store/axios.js from this variable.
# Paths in src/services/api.js are relative (e.g. /auth/login/, /courses/),
# so the value MUST include the /api prefix.

# Local Django
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production — set on the server in languagelearnfe/.env.local
# (Next.js inlines NEXT_PUBLIC_* at `yarn build`, so change then rebuild)
# NEXT_PUBLIC_API_URL=https://your-domain.com/api
