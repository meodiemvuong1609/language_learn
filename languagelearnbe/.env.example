# ============================================================
# Django Settings
# ============================================================
DEBUG=True
SECRET_KEY=changeme-django-secret-key
# Alias also accepted by settings.py:
# DJANGO_SECRET_KEY=changeme-django-secret-key
ENV_ALLOWED_HOSTS=localhost,127.0.0.1
ENV_ALLOWED_CORS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:3001
ENV_ALLOWED_ORIGIN_REGEXES=

# ============================================================
# PostgreSQL Database
# ============================================================
POSTGRES_DB=languagelearn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# Backblaze B2 (File Storage)
# ============================================================
BACKBLAZEB2_APP_KEY_ID=changeme
BACKBLAZEB2_APP_KEY=changeme
BACKBLAZEB2_BUCKET_NAME=changeme
BACKBLAZEB2_BUCKET_ID=changeme
BACKBLAZEB2_ACCOUNT_ID=changeme

# ============================================================
# Email (SMTP)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=changeme@gmail.com
EMAIL_HOST_PASSWORD=changeme-app-password

# ============================================================
# Firebase (FCM Push Notifications)
# ============================================================
KEY_FCM=changeme
ApiKey=changeme
AuthDomain=changeme.firebaseapp.com
DatabaseURL=https://changeme-default-rtdb.firebaseio.com
ProjectId=changeme
StorageBucket=changeme.appspot.com
MessagingSenderId=changeme
AppId=changeme
MeasurementId=changeme

# ============================================================
# Frontend URL (for password reset links)
# ============================================================
FRONTEND_URL=http://localhost:3001
